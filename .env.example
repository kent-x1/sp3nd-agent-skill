# SP3ND API credentials — get these from https://sp3nd.shop
SP3ND_API_KEY=sp3nd_your_api_key_here
SP3ND_API_SECRET=sp3nd_sec_your_api_secret_here

# Stable key for one intended checkout. Persist and reuse it on retries.
SP3ND_IDEMPOTENCY_KEY=checkout_your_stable_key_here

# Purchase input. SP3ND resolves listing details and monetary values.
SP3ND_PRODUCT_URL=https://www.amazon.com/dp/example
SP3ND_PRODUCT_QUANTITY=1

# Receipt and complete final destination (one-line JSON).
SP3ND_CUSTOMER_EMAIL=buyer@example.com
SP3ND_SHIPPING_ADDRESS_JSON={"name":"Buyer Name","recipient":"Buyer Name","address1":"123 Main St","address2":"","city":"Austin","state":"TX","postalCode":"78701","country":"United States","countryCode":"US","phone":"+15125550123"}

# Path to your Solana wallet JSON (must contain a "secret" array)
# Defaults to ./.wallet.json if not set
AGENT_WALLET_PATH=/path/to/your/wallet.json

# End-user wallet for order history and points attribution.
# Defaults to the agent payment wallet when omitted.
SP3ND_USER_WALLET=

# If the current quote requires a shipping choice, use an opaque option ID
# returned by GET /getPartnerOrder. Never construct an option or price.
SP3ND_SHIPPING_OPTION_ID=

# Default 0 stops safely on manual review. Set a bounded wait to poll for a quote.
SP3ND_MAX_QUOTE_WAIT_SECONDS=0
SP3ND_POLL_INTERVAL_SECONDS=10
SP3ND_QUOTE_SAFETY_SECONDS=30

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional overrides
SP3ND_API_BASE_URL=https://us-central1-sp3nddotshop-prod.cloudfunctions.net
